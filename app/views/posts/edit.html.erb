<div class="cover-edit">
  <div class=container">
    <div class="row">
      <h1 class="font-weight-normal mt-5 mb-5">旅行投稿編集</h1>
    </div>
    <% if @post.errors.any? %>
      <div class="card text-center text-white bg-danger mt-3">
        <%= @post.errors.count %>件のエラーが発生しました
        <% @post.errors.full_messages.each do |message| %>
          <%= message %>
        <% end %>
      </div>
    <% end %>
    <%= form_with model:@post, local:true do|f| %>
    <h4>旅行先</h4>
    <%= f.text_field :location %>
    <h4>感想</h4>
    <%= f.text_area :text %><br>
    <h4>画像</h4>
    <% if @post.image.attached? %>
     <%= image_tag @post.image.varient(resize_to_limit: [450, 350]) %><br>
    <% end %>
    <div class="form-group">
      <%= f.select :status, Post.statuses.keys.map { |k| [t("enums.post.status.#{k}"),k]}, {}, {class: "custom-select w-25 mb-3"} %>
    </div>
    <h4>画像を変更する</h4>
    <%= f.file_field :image %><br>
    <%= f.submit '保存' %>
<% end %>